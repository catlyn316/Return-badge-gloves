-- 輔助：找物件下第一個 BasePart
local function getBasePart(obj)
    if obj:IsA("BasePart") then return obj end
    for _, v in ipairs(obj:GetDescendants()) do
        if v:IsA("BasePart") then return v end
    end
    return nil
end

-- 安全傳送函數（修復版） - 防止黑屏和掉落
local function safeTeleport(targetCFrame, offsetY)
    pcall(function()
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        
        local hrp = char.HumanoidRootPart
        offsetY = offsetY or 3
        
        -- 計算傳送位置
        local newPos = targetCFrame.Position + Vector3.new(0, offsetY, 0)
        
        -- 檢查傳送位置是否有效（防止超出邊界）
        local maxHeight = 500
        local minHeight = -500
        
        if newPos.Y > maxHeight then
            newPos = Vector3.new(newPos.X, maxHeight, newPos.Z)
        elseif newPos.Y < minHeight then
            newPos = Vector3.new(newPos.X, minHeight, newPos.Z)
        end
        
        -- 設置角色位置
        hrp.CFrame = CFrame.new(newPos)
        task.wait(0.05)
    end)
end

-- 點擊屏幕中央
local function clickScreen()
    pcall(function()
        local camera = Workspace.CurrentCamera
        local viewportSize = camera.ViewportSize
        local centerX = viewportSize.X / 2
        local centerY = viewportSize.Y / 2
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
        task.wait(0.01)
        VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
    end)
end

-- 面對目標
local function faceTarget(target)
    pcall(function()
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and target then
            local hrp = char.HumanoidRootPart
            hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(target.Position.X, hrp.Position.Y, target.Position.Z))
        end
    end)
end

