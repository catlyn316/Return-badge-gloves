-- 自動獲取功能
autoCollectBtn.MouseButton1Click:Connect(function()
    toggles.autoCollect = not toggles.autoCollect

    if toggles.autoCollect then
        autoCollectBtn.Text = "停止"
        autoCollectBtn.BackgroundColor3 = Color3.fromRGB(244, 67, 54)
        autoCollectFrame.BackgroundColor3 = Color3.fromRGB(200, 230, 201)
        conkerCount = 0
        isAtBowl = false
        isHandlingSquirrel = false

        task.spawn(function()
            while toggles.autoCollect do
                task.wait(0.1)
                
                -- 檢查松鼠（優先處理）
                local squirrels = {}
                if Workspace:FindFirstChild("NPCs") then
                    for _, obj in pairs(Workspace.NPCs:GetChildren()) do
                        if obj.Name == "squirrel" then
                            table.insert(squirrels, obj)
                        end
                    end
                end

                -- 如果有松鼠，處理松鼠
                if #squirrels > 0 and not isAtBowl then
                    isHandlingSquirrel = true
                    
                    for _, squirrel in ipairs(squirrels) do
                        while squirrel and squirrel.Parent and toggles.autoCollect do
                            pcall(function()
                                local squirrelPart = getBasePart(squirrel)
                                local char = player.Character
                                if char and char:FindFirstChild("HumanoidRootPart") and squirrelPart then
                                    safeTeleport(squirrelPart.CFrame, 2)
                                    task.wait(0.15)
                                    faceTarget(squirrelPart)
                                    task.wait(0.05)
                                    clickScreen()
                                end
                            end)
                            task.wait(0.15)
                            
                            if not squirrel.Parent then
                                break
                            end
                        end
                    end
                    
                    isHandlingSquirrel = false
                    task.wait(0.3)
                end

                -- 如果正在處理松鼠，跳過conker收集
                if isHandlingSquirrel then
                    continue
                end

                -- 如果需要去碗（收集了7個conker）
                if conkerCount >= 7 and not isAtBowl then
                    isAtBowl = true
                    
                    pcall(function()
                        local bowl = Workspace:FindFirstChild("Map")
                        if bowl then
                            bowl = bowl:FindFirstChild("CoreAssets")
                            if bowl then
                                bowl = bowl:FindFirstChild("Bowl")
                                if bowl then
                                    local bowlPart = bowl:FindFirstChild("bowl")
                                    local char = player.Character
                                    if char and char:FindFirstChild("HumanoidRootPart") and bowlPart then
                                        safeTeleport(bowlPart.CFrame, 3)
                                        task.wait(0.5)
                                        
                                        local proximityPrompt = bowl:FindFirstChild("ProximityPrompt")
                                        if proximityPrompt then
                                            fireproximityprompt(proximityPrompt)
                                        end
                                        task.wait(0.5)
                                    end
                                end
                            end
                        end
                    end)
                    
                    conkerCount = 0
                    isAtBowl = false
                    task.wait(0.5)
                end

                -- 收集conker
                if not isAtBowl then
                    pcall(function()
                        local conkers = {}
                        for _, obj in pairs(Workspace:GetChildren()) do
                            if obj.Name == "Conker" then
                                table.insert(conkers, obj)
                            end
                        end

                        if #conkers > 0 then
                            local targetConker = conkers[math.random(1, #conkers)]
                            local conkerPart = getBasePart(targetConker)
                            local char = player.Character
                            
                            if char and char:FindFirstChild("HumanoidRootPart") and conkerPart then
                                safeTeleport(conkerPart.CFrame, 3)
                                conkerCount = conkerCount + 1
                                task.wait(0.3)
                            end
                        end
                    end)
                end
            end
        end)
    else
        autoCollectBtn.Text = "啟動"
        autoCollectBtn.BackgroundColor3 = Color3.fromRGB(129, 199, 132)
        autoCollectFrame.BackgroundColor3 = Color3.fromRGB(248, 249, 250)
        conkerCount = 0
        isAtBowl = false
        isHandlingSquirrel = false
    end
end)

