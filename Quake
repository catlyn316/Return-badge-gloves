quakeBtn.MouseButton1Click:Connect(function()
    quakeRunning = not quakeRunning
    if quakeRunning then
        local targetPlayer, _ = findPlayerByPartialName(quakeTargetInput.Text)
        if not targetPlayer then
            quakeStatusLabel.Text = "找不到玩家"
            quakeStatusLabel.TextColor3 = THEME.red
            quakeRunning = false; return
        end

        quakeBtn.Text = "停止"; quakeBtn.BackgroundColor3 = THEME.red
        r31.BackgroundColor3 = Color3.fromRGB(20, 8, 4)
        activeFeatures["地震"] = true; updateStatus()

        quakeThread = task.spawn(function()
            local char = player.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then resetQuakeUI() return end

            local tgtRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            local OGLSize = tgtRoot and tgtRoot.Size

            -- 步驟1：啟動 HomeRun + Woah
            quakeStatusLabel.Text = "啟動 HomeRun…"; quakeStatusLabel.TextColor3 = THEME.accent
            pcall(function() ReplicatedStorage.HomeRun:FireServer({["start"] = true}) end)
            pcall(function()
                local lobby = Workspace:FindFirstChild("Lobby")
                if lobby and lobby:FindFirstChild("woah") then
                    fireclickdetector(lobby.woah.ClickDetector)
                end
            end)
            task.wait(4.2)
            if not quakeRunning then resetQuakeUI() return end

            -- 步驟2：瞬移到目標位置，面向揮棒設定位置（若有設定）後發動 VineThud
            quakeStatusLabel.Text = "瞬移 + VineThud…"
            tgtRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            pcall(function()
                if not tgtRoot then return end
                if quakeSwingCF then
                    -- 移到目標位置，但朝向揮棒設定點
                    local standPos  = tgtRoot.Position
                    local swingPos  = quakeSwingCF.Position
                    local lookAt    = CFrame.new(standPos, Vector3.new(swingPos.X, standPos.Y, swingPos.Z))
                    hrp.CFrame = lookAt
                else
                    hrp.CFrame = tgtRoot.CFrame
                end
            end)
            task.wait(0.2)
            pcall(function() ReplicatedStorage.VineThud:FireServer() end)
            task.wait(1)
            if not quakeRunning then resetQuakeUI() return end

            -- 步驟3：點終點 + 放大目標 + 移動到揮棒位置（或目標位置）並面向目標 + finished
            quakeStatusLabel.Text = "觸發 HomeRun 終點…"
            pcall(function()
                local lobby = Workspace:FindFirstChild("Lobby")
                if lobby and lobby:FindFirstChild("Home Run") then
                    fireclickdetector(lobby["Home Run"].ClickDetector)
                end
            end)
            pcall(function()
                tgtRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if tgtRoot then tgtRoot.Size = Vector3.new(50, 50, 50) end
            end)
            task.wait(0.2)

            -- 揮棒位置：有設定 → 移到設定位置並面向目標；沒設定 → 移到目標位置
            pcall(function()
                tgtRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if quakeSwingCF and tgtRoot then
                    local swingPos  = quakeSwingCF.Position
                    local targetPos = tgtRoot.Position
                    local lookAt    = CFrame.new(swingPos, Vector3.new(targetPos.X, swingPos.Y, targetPos.Z))
                    hrp.CFrame = lookAt
                elseif tgtRoot then
                    hrp.CFrame = tgtRoot.CFrame
                end
            end)
            task.wait(0.1)
            pcall(function() ReplicatedStorage.HomeRun:FireServer({["finished"] = true}) end)

            -- 步驟4：還原大小
            quakeStatusLabel.Text = "還原大小中…"
            task.wait(3)
            pcall(function()
                tgtRoot = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if tgtRoot and OGLSize then tgtRoot.Size = OGLSize end
            end)

            quakeStatusLabel.Text = "流程結束 ✅"; quakeStatusLabel.TextColor3 = THEME.green
            resetQuakeUI()
        end)
    else
        if quakeThread then task.cancel(quakeThread) quakeThread = nil end
        resetQuakeUI()
    end
end)

