stunBtn.MouseButton1Click:Connect(function()
    stunRunning = not stunRunning
    if stunRunning then
        stunCount = 0
        stunCountLabel.Text = "計數: 0/50"
        stunCountLabel.TextColor3 = THEME.textMuted
        stunBtn.Text = "停止"; stunBtn.BackgroundColor3 = THEME.red
        r12.BackgroundColor3 = Color3.fromRGB(20, 8, 4)
        activeFeatures["能力(動能)"] = true; updateStatus()

        stunThread = task.spawn(function()
            local inputText = stunTargetInput.Text
            local fixedTarget, _ = findPlayerByPartialName(inputText)
            local useFixed = (fixedTarget ~= nil)

            local charConn = nil
            local function watchDeath()
                local char = player.Character
                if not char then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum then return end
                if charConn then pcall(function() charConn:Disconnect() end) end
                charConn = hum.Died:Connect(function()
                    stunCount = 0
                    stunCountLabel.Text = "計數: 0/50（死亡重置）"
                    stunCountLabel.TextColor3 = THEME.red
                end)
            end
            watchDeath()
            player.CharacterAdded:Connect(function() task.wait(0.5); watchDeath() end)

            local stunOGL = nil

            while stunRunning do
                local char = player.Character
                local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then task.wait(0.2) continue end

                if useFixed then
                    local tgt = Players:FindFirstChild(fixedTarget.Name)
                    if not tgt or not tgt.Character then task.wait(0.2) continue end
                    local tgtRoot = tgt.Character:FindFirstChild("HumanoidRootPart")
                    if not tgtRoot then task.wait(0.2) continue end

                    local selfCF = hrp.CFrame
                    pcall(function() hrp.CFrame = tgtRoot.CFrame * CFrame.new(0, -20, 0) end)
                    task.wait(0.2)
                    local stunObj = player.Character and player.Character:FindFirstChild("Stun")
                    if stunObj then pcall(function() ReplicatedStorage.StunR:FireServer(stunObj) end) end
                    pcall(function() hrp.CFrame = selfCF end)
                else
                    local target = getNearestEntered()
                    if not target or not target.Character then task.wait(0.2) continue end
                    local tgtRoot = target.Character:FindFirstChild("HumanoidRootPart")
                    if not tgtRoot then task.wait(0.2) continue end

                    if not stunOGL then stunOGL = hrp.CFrame end
                    pcall(function() hrp.CFrame = tgtRoot.CFrame * CFrame.new(0, -20, 0) end)
                    task.wait(0.25)
                    local stunObj = player.Character and player.Character:FindFirstChild("Stun")
                    if stunObj then pcall(function() ReplicatedStorage.StunR:FireServer(stunObj) end) end
                    pcall(function() hrp.CFrame = stunOGL end)
                end

                stunCount = stunCount + 1
                stunCountLabel.Text = "計數: " .. stunCount .. "/50"
                stunCountLabel.TextColor3 = THEME.accent

                if stunCount >= 50 then
                    stunCountLabel.Text = "計數: 50/50 ✅"
                    stunCountLabel.TextColor3 = THEME.green
                    break
                end

                task.wait(12.3)
            end

            if charConn then pcall(function() charConn:Disconnect() end) end
            resetStunUI()
        end)
    else
        if stunThread then task.cancel(stunThread) stunThread = nil end
        resetStunUI()
    end
end)

