local function resetStunUI()
    stunRunning = false; stunThread = nil
    stunBtn.Text = "啟動"; stunBtn.BackgroundColor3 = THEME.primary
    r12.BackgroundColor3 = THEME.bgRow
    activeFeatures["能力(動能)"] = false; updateStatus()
