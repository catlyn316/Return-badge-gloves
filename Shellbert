        if not hrp then return end
        
        local found = 0
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local distance = (obj.Parent.Position - hrp.Position).Magnitude
                if distance < 50 then
                    fireproximityprompt(obj)
                    found = found + 1
                    task.wait(0.2)
                end
            end
        end
        
        autoFixBtn.Text = "✓" .. found
        autoFixBtn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
        task.wait(1.5)
        autoFixBtn.Text = "啟動"
        autoFixBtn.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
    end)
end)

