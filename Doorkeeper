-- ── startGrabbing / stopGrabbing ──
local function startGrabbing()
    grabbing = true
    grabButton.Text             = "🔴  停止獲取"
    grabButton.BackgroundColor3 = THEME.red
    grabStroke.Color            = Color3.fromRGB(140, 20, 40)
    grabFrame.BackgroundColor3  = Color3.fromRGB(28, 8, 14)
    statusLabel.Text            = "✅ 獲取中..."
    statusLabel.TextColor3      = THEME.green

    grabThread = task.spawn(function()
        local cycle = 0
        while grabbing do
            cycle = cycle + 1
            local found = 0
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("ClickDetector") then
                    found = found + 1
                    pcall(function() fireclickdetector(obj) end)
                end
            end
            countLabel.Text      = string.format("第 %d 輪 ｜ 偵測到 %d 個 ClickDetector", cycle, found)
            countLabel.TextColor3 = THEME.accentGlow
            task.wait(0.5)
        end
    end)
end

local function stopGrabbing()
    grabbing = false
    if grabThread then task.cancel(grabThread) grabThread = nil end
    grabButton.Text             = "🛸  開始獲取"
    grabButton.BackgroundColor3 = THEME.primary
    grabStroke.Color            = THEME.primaryDark
    grabFrame.BackgroundColor3  = THEME.bgRow
    statusLabel.Text            = "系統就緒"
    statusLabel.TextColor3      = THEME.primary
    countLabel.Text             = "等待啟動中..."
    countLabel.TextColor3       = THEME.textMuted
end

grabButton.MouseButton1Click:Connect(function()
    if not grabbing then startGrabbing() else stopGrabbing() end
end)

