local function findPlayerByPartialName(input)
    if not input or input == "" then return nil, "請輸入玩家名稱" end
    input = input:lower()
    local matches = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if p.Name:lower():sub(1, #input) == input
            or p.DisplayName:lower():sub(1, #input) == input then
                table.insert(matches, p)
            end
        end
    end
    if #matches == 0 then
        return nil, "找不到玩家"
    elseif #matches == 1 then
        return matches[1], nil
    else
        local names = {}
        for _, p in ipairs(matches) do table.insert(names, p.Name) end
        return nil, "多個符合: " .. table.concat(names, ", ")
    end
end

local function getHRP()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- 等待工具欄出現任意 Tool（timeout 秒後放棄）
local function waitForTool(timeout)
    local deadline = tick() + (timeout or 10)
    while tick() < deadline do
        local char = player.Character
        if char then
            for _, obj in ipairs(char:GetChildren()) do
                if obj:IsA("Tool") then return true end
            end
        end
        local bp = player:FindFirstChildOfClass("Backpack")
        if bp then
            for _, obj in ipairs(bp:GetChildren()) do
                if obj:IsA("Tool") then return true end
            end
        end
        task.wait(0.05)
    end
    return false
end

local function teleportToLobby()
    pcall(function()
        local hrp = getHRP()
        if hrp then
            hrp.CFrame = Workspace.Lobby.Teleport1.CFrame
        end
    end)
end

local function teleportInFrontOf(tgt, distance)
    pcall(function()
        local hrp = getHRP()
        local tgtRoot = tgt.Character and tgt.Character:FindFirstChild("HumanoidRootPart")
        if hrp and tgtRoot then
            local lookDir = tgtRoot.CFrame.LookVector
            local newPos  = tgtRoot.Position + lookDir * distance
            hrp.CFrame    = CFrame.new(newPos, tgtRoot.Position)
        end
    end)
end

