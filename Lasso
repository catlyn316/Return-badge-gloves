local function resolveTarget()
    local tgt, err = findPlayerByPartialName(targetInput.Text)
    if not tgt then
        setStatus(err or "找不到玩家", Color3.fromRGB(220, 60, 60))
        return nil
    end
    targetPlayer = tgt
    return tgt
end

