    if beatBusy then return end
    local tgt = resolveTarget()
    if not tgt then return end

    beatBusy = true
    local origColor = beatBtn.BackgroundColor3
    beatBtn.BackgroundColor3 = Color3.fromRGB(50, 95, 30)
    beatBtn.Text = "執行中..."

    task.spawn(function()

        -- 1. 換裝：Knockoff
        setStatus("換裝 Knockoff...", THEME.textSub)
        pcall(function()
            fireclickdetector(Workspace.Lobby["Knockoff"].ClickDetector)
        end)

        -- 2. 傳送到目標前方 5 單位
        setStatus("傳送目標旁...", THEME.textSub)
        teleportInFrontOf(tgt, 5)
        task.wait(0.3)

        -- 3. GeneralHit → 目標頭部
        setStatus("斷頭！", THEME.accent)
        pcall(function()
            local head = tgt.Character and tgt.Character:FindFirstChild("Head")
            if head then
                ReplicatedStorage.GeneralHit:FireServer(head)
            end
        end)

        -- 4. 換裝：Beatdown
        setStatus("換裝 Beatdown...", THEME.textSub)
        pcall(function()
            fireclickdetector(Workspace.Lobby["Beatdown"].ClickDetector)
        end)

        -- 5. 傳送回 Teleport1
        setStatus("傳送大廳等工具...", THEME.textSub)
        teleportToLobby()

        -- 6. 等工具欄出現任意 Tool 再繼續
        waitForTool(10)

        -- 7. 持續 3 秒：傳送到目標前 5 單位 + GeneralAbility
        setStatus("連打中！（3秒）", THEME.accent)
        local endTime = tick() + 3
        while tick() < endTime do
            teleportInFrontOf(tgt, 5)
            pcall(function()
                ReplicatedStorage.GeneralAbility:FireServer()
            end)
            task.wait(0.05)
        end

        -- 8. 等 0.5 秒後點擊螢幕
        task.wait(0.5)
        pcall(function() mouse1click() end)

        setStatus("斷頭連打完成！", THEME.accent)
        beatBtn.Text             = "斷頭+連打"
        beatBtn.BackgroundColor3 = origColor
        beatBusy = false
    end)
end)

