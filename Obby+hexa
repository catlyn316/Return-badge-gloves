local function safeTeleport(x, y, z)
    pcall(function()
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart
        hrp.CFrame = CFrame.new(x, y, z)
        task.wait(0.05)
    end)
end

local function unanchorCharacter()
    pcall(function()
        local char = player.Character
        if not char then return end
        
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Anchored = false
            end
        end
    end)
end

local function noclipCharacter(shouldNoclip)
    pcall(function()
        local char = player.Character
        if not char then return end
        
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not shouldNoclip
            end
        end
    end)
end

local function noclipCamera(shouldNoclip)
    pcall(function()
        local camera = Workspace.CurrentCamera
        if camera:IsA("BasePart") then
            camera.CanCollide = not shouldNoclip
        end
    end)
end

