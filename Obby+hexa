local function updateManualAbsorbButton()
    if manualAbsorbCooldown <= 0 then
        manualAbsorbBtn.Text = "發動"
        manualAbsorbBtn.BackgroundColor3 = Color3.fromRGB(173, 216, 230)
    else
        manualAbsorbBtn.Text = "冷卻" .. math.ceil(manualAbsorbCooldown)
        manualAbsorbBtn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
    end
end

manualAbsorbBtn.MouseButton1Click:Connect(function()
    if manualAbsorbCooldown <= 0 then
        pcall(function()
            fireclickdetector(Workspace.Lobby["Za Hando"].ClickDetector)
            task.wait(0.3)
            ReplicatedStorage.Erase:FireServer()
            
            manualAbsorbCooldown = manualAbsorbMaxCooldown
            updateManualAbsorbButton()
            
            if cooldownConnection then
                cooldownConnection:Disconnect()
            end
            
            cooldownConnection = RunService.Heartbeat:Connect(function(deltaTime)
                manualAbsorbCooldown = manualAbsorbCooldown - deltaTime
                if manualAbsorbCooldown <= 0 then
                    manualAbsorbCooldown = 0
                    cooldownConnection:Disconnect()
                end
                updateManualAbsorbButton()
            end)
        end)
    end
end)

