-- ============================================================
-- 輔助函數：等待 Workspace 路徑出現
-- ============================================================
local function waitForPath(pathTable, timeout)
    local t = tick()
    while tick() - t < (timeout or 60) do
        if not toggles.gloveGrab then return nil end
        local cur = Workspace
        local ok = true
        for _, part in ipairs(pathTable) do
            local found = cur:FindFirstChild(part)
            if not found then ok = false break end
            cur = found
        end
        if ok then return cur end
        task.wait(0.2)
    end
    return nil
end

-- 輔助函數：從 Model 或 BasePart 取得 CFrame
local function getObjectCFrame(obj)
    if not obj then return nil end
    -- 直接是 BasePart
    if obj:IsA("BasePart") then
        return obj.CFrame
    end
    -- Model 有 PrimaryPart
    if obj:IsA("Model") and obj.PrimaryPart then
        return obj.PrimaryPart.CFrame
    end
    -- 遞迴找第一個 BasePart
    local function findPart(o)
        for _, child in ipairs(o:GetChildren()) do
            if child:IsA("BasePart") then return child end
            local found = findPart(child)
            if found then return found end
        end
        return nil
    end
    local part = findPart(obj)
    if part then return part.CFrame end
    return nil
end

-- 輔助函數：傳送玩家到目標物件旁（含重試）
local function teleportTo(hrp, obj, offsetY)
    offsetY = offsetY or 3
    local cf = getObjectCFrame(obj)
    if not cf then return false end
    local targetCF = cf + Vector3.new(0, offsetY, 0)
    -- 重試最多 10 次直到距離 < 10 或成功
    for _ = 1, 10 do
        if not (hrp and hrp.Parent) then return false end
        pcall(function() hrp.CFrame = targetCF end)
        task.wait(0.15)
        -- 驗證是否傳送成功（距離小於 15 studs 視為成功）
        local ok = false
        pcall(function()
            if (hrp.Position - targetCF.Position).Magnitude < 15 then
                ok = true
            end
        end)
        if ok then return true end
    end
    return false
end

-- 輔助函數：遞迴找 ClickDetector（深度最多 5 層）
local function findClickDetector(obj, depth)
    depth = depth or 0
    if depth > 5 then return nil end
    if not obj then return nil end
    local cd = obj:FindFirstChildOfClass("ClickDetector")
    if cd then return cd end
    for _, child in ipairs(obj:GetChildren()) do
        local found = findClickDetector(child, depth + 1)
        if found then return found end
    end
    return nil
end

-- 輔助函數：觸發一次 ClickDetector
local function fireCD(cd)
    if not cd then return end
    pcall(function()
        if fireclickdetector then
            fireclickdetector(cd)
        elseif getgenv and getgenv().fireclickdetector then
            getgenv().fireclickdetector(cd)
        else
            cd.MouseClick:Fire(player)
        end
    end)
end

-- 輔助函數：對物件持續觸發 CD，直到 stopFlag() 回傳 true
local function tryClickDetector(obj)
    if not obj then return false end
    local cd = findClickDetector(obj)
    if cd then fireCD(cd) return true end
    return false
end

