-- 獲取手套主邏輯
-- ============================================================
local function runGloveGrabLoop()
    -- 等角色載入
    local char, hrp
    for _ = 1, 30 do
        char = player.Character
        if char then
            hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then break end
        end
        task.wait(0.2)
    end

    if not hrp then
        setStatus("找不到 HumanoidRootPart", THEME.red)
        return
    end

    -- ── 步驟 1：傳送至 Portal1 ──────────────────────────────
    setStep(1)
    setStatus("正在尋找 Portal1...", THEME.accent)

    local portal1 = waitForPath({"Map", "Lobby", "Portal1"}, 30)
    if not portal1 then
        setStatus("找不到 Portal1，已中止", THEME.red)
        toggles.gloveGrab = false
        return
    end

    -- 重新抓角色（spawn 後可能重置）
    char = player.Character
    hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then setStatus("角色不存在", THEME.red) toggles.gloveGrab = false return end

    teleportTo(hrp, portal1)
    task.wait(0.4)

    -- 持續觸發 Challenge1.RedButton.Button.ClickDetector 直到 Portal2 出現
    setStatus("觸發 Challenge1 RedButton...", THEME.accent)
    local portal2Found = false
    local cdLoop1 = task.spawn(function()
        while toggles.gloveGrab and not portal2Found do
            local cd = nil
            pcall(function()
                cd = Workspace.Map.Challenge1.RedButton.Button:FindFirstChildOfClass("ClickDetector")
            end)
            if cd then fireCD(cd) end
            task.wait(0.25)
        end
    end)

    -- ── 步驟 2：等待 Portal2 出現並觸發 ────────────────────
    setStep(2)
    setStatus("等待 Portal2 出現...", THEME.accent)

    local portal2 = waitForPath({"Map", "Lobby", "Portal2"}, 60)
    portal2Found = true
    task.cancel(cdLoop1)

    if not portal2 then
        setStatus("找不到 Portal2，已中止", THEME.red)
        toggles.gloveGrab = false
        return
    end

    char = player.Character
    hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then setStatus("角色不存在", THEME.red) toggles.gloveGrab = false return end

    teleportTo(hrp, portal2)
    task.wait(0.4)

    -- 持續觸發 Challenge2.RedButton.Button.ClickDetector 直到 Portal3 出現
    setStatus("觸發 Challenge2 RedButton...", THEME.accent)
    local portal3Found = false
    local cdLoop2 = task.spawn(function()
        while toggles.gloveGrab and not portal3Found do
            local cd = nil
            pcall(function()
                cd = Workspace.Map.Challenge2.RedButton.Button:FindFirstChildOfClass("ClickDetector")
            end)
            if cd then fireCD(cd) end
            task.wait(0.25)
        end
    end)

    -- ── 步驟 3：等待 Portal3 出現並觸發 ────────────────────
    setStep(3)
    setStatus("等待 Portal3 出現...", THEME.accent)

    local portal3 = waitForPath({"Map", "Lobby", "Portal3"}, 60)
    portal3Found = true
    task.cancel(cdLoop2)

    if not portal3 then
        setStatus("找不到 Portal3，已中止", THEME.red)
        toggles.gloveGrab = false
        return
    end

    char = player.Character
    hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then setStatus("角色不存在", THEME.red) toggles.gloveGrab = false return end

    teleportTo(hrp, portal3)
    task.wait(0.4)

    -- 持續觸發 Challenge3.RedButton.Button.ClickDetector 直到 EndPortal 出現
    setStatus("觸發 Challenge3 RedButton...", THEME.accent)
    local endPortalFound = false
    local cdLoop3 = task.spawn(function()
        while toggles.gloveGrab and not endPortalFound do
            local cd = nil
            pcall(function()
                cd = Workspace.Map.Challenge3.RedButton.Button:FindFirstChildOfClass("ClickDetector")
            end)
            if cd then fireCD(cd) end
            task.wait(0.25)
        end
    end)

    -- ── 步驟 4：等待 EndPortal 出現並傳送 ──────────────────
    setStep(4)
    setStatus("等待 EndPortal 出現...", THEME.accent)

    local endPortal = waitForPath({"Map", "Lobby", "EndPortal"}, 60)
    endPortalFound = true
    task.cancel(cdLoop3)

    if not endPortal then
        setStatus("找不到 EndPortal，已中止", THEME.red)
        toggles.gloveGrab = false
        return
    end

    char = player.Character
    hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then setStatus("角色不存在", THEME.red) toggles.gloveGrab = false return end

    teleportTo(hrp, endPortal)
    task.wait(0.4)

    -- 觸發 EndPortal 的 ClickDetector（若有）
    tryClickDetector(endPortal)

    -- 完成
    for _, lbl in ipairs(stepLabels) do
        lbl.TextColor3 = THEME.green
    end
    setStatus("✅ 完成！手套已獲取", THEME.green)
    toggles.gloveGrab = false

    -- 重置按鈕
    gloveButton.Text = "觸發"
    gloveButton.BackgroundColor3 = THEME.primary
    gloveFrame.BackgroundColor3 = THEME.bgRow
    gloveStatus.Text = "完成"
    gloveStatus.TextColor3 = THEME.green
end

